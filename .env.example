# Offline mock mode needs no configuration.
# Live mode: export these values or pass --env-file .env. No shell code is executed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verified against the official DeepSeek documentation on 2026-10-28; configurable.
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=4096
